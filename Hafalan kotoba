<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Quiz Kosakata Jepang — Kotoba Quiz</title>
  <style>
    body{font-family:Inter,ui-sans-serif,system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial; background:linear-gradient(180deg,#f8fafc,#eef2ff);color:#0f172a;padding:24px}
    .card{max-width:760px;margin:18px auto;padding:20px;border-radius:12px;background:#fff;box-shadow:0 6px 18px rgba(2,6,23,0.08)}
    h1{font-size:20px;margin:0 0 8px}
    p.lead{margin:0 0 18px;color:#475569}
    .q{padding:12px;border-radius:8px;border:1px solid #e6eef8;margin-bottom:12px}
    .opts{display:flex;flex-direction:column;gap:8px;margin-top:8px}
    label.opt{display:block;padding:10px;border-radius:8px;border:1px solid #e6eef8;cursor:pointer}
    label.opt input{margin-right:8px}
    .controls{display:flex;gap:8px;align-items:center;margin-top:12px}
    button{background:#4f46e5;color:#fff;border:0;padding:10px 12px;border-radius:8px;cursor:pointer}
    button.ghost{background:transparent;color:#334155;border:1px solid #e6eef8}
    .result{margin-top:16px;padding:12px;border-radius:8px;background:#f1f5f9}
    .small{font-size:13px;color:#64748b}
    .correct{color:#065f46;font-weight:600}
    .wrong{color:#b91c1c;font-weight:600}
    footer{margin-top:18px;font-size:13px;color:#64748b;text-align:center}
  </style>
</head>
<body>
  <div class="card">
    <h1>Quiz Kosakata Jepang — Multiple Choice</h1>
    <p class="lead">Tebak arti kata Jepang (ditulis dalam hiragana/katakana). Pilih jawaban terbaik, lalu tekan "Selesai".</p>

    <div id="quiz"></div>

    <div class="controls">
      <button id="submit">Selesai — Tampilkan Skor</button>
      <button id="retry" class="ghost">Ulangi</button>
      <div style="margin-left:auto" class="small">Soal: <span id="total">0</span></div>
    </div>

    <div id="result" class="result" style="display:none"></div>
    <footer>File ini bisa disimpan sebagai <code>.html</code> dan dibuka di browser — offline works.</footer>
  </div>

  <script>
    const QUESTIONS = [
      {q: 'いく (iku)', a: 'pergi'},
      {q: 'たべる (taberu)', a: 'makan'},
      {q: 'ねる (neru)', a: 'tidur'},
      {q: 'ありがとう (arigatou)', a: 'terima kasih'},
      {q: 'すき (suki)', a: 'suka'},
      {q: 'きれい (kirei)', a: 'cantik / bersih'},
      {q: 'いえ (ie)', a: 'rumah'},
      {q: 'でんしゃ (densha)', a: 'kereta'},
      {q: 'くるま (kuruma)', a: 'mobil'},
      {q: 'ほん (hon)', a: 'buku'}
    ];

    function shuffle(array){ for(let i=array.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[array[i],array[j]]=[array[j],array[i]]} return array }

    function makeOptions(correct, pool){
      const opts = new Set([correct]);
      while(opts.size < 4){
        const cand = pool[Math.floor(Math.random()*pool.length)];
        opts.add(cand);
      }
      return shuffle(Array.from(opts));
    }

    function buildQuiz(){
      const quizDiv = document.getElementById('quiz'); quizDiv.innerHTML='';
      const pool = QUESTIONS.map(x=>x.a);
      const order = shuffle(QUESTIONS.map((q,i)=>i)).slice(0,10);
      order.forEach((idx, qi)=>{
        const item = QUESTIONS[idx];
        const opts = makeOptions(item.a, pool);
        const wrapper = document.createElement('div'); wrapper.className='q';
        wrapper.innerHTML = `<div><strong>${qi+1}.</strong> <span style="font-size:18px">${item.q}</span></div>`;
        const optsDiv = document.createElement('div'); optsDiv.className='opts';
        opts.forEach((opt, oi)=>{
          const id = `q${qi}_o${oi}`;
          const label = document.createElement('label'); label.className='opt';
          label.innerHTML = `<input type="radio" name="q${qi}" value="${opt}" id="${id}"> ${opt}`;
          optsDiv.appendChild(label);
        });
        wrapper.appendChild(optsDiv);
        quizDiv.appendChild(wrapper);
      });
      document.getElementById('total').textContent = order.length;
    }

    function grade(){
      const quizDiv = document.getElementById('quiz');
      const qs = quizDiv.querySelectorAll('.q');
      let score=0; const feedback=[];
      qs.forEach((qDiv, i)=>{
        const qText = qDiv.querySelector('div').innerText.trim();
        const sel = qDiv.querySelector('input[type=radio]:checked');
        const chosen = sel ? sel.value : null;
        const original = QUESTIONS.find(x=>qText.includes(x.q)).a;
        const correct = (chosen === original);
        if(correct) score++;
        feedback.push({i:i+1, q:qText, chosen, original, correct});
      });
      return {score, total:qs.length, feedback};
    }

    document.getElementById('submit').addEventListener('click', ()=>{
      const res = grade();
      const rdiv = document.getElementById('result'); rdiv.style.display='block';
      rdiv.innerHTML = `<div><strong>Skor: ${res.score} / ${res.total}</strong></div>`;
      const list = document.createElement('div'); list.style.marginTop='10px';
      res.feedback.forEach(f=>{
        const el = document.createElement('div');
        el.innerHTML = `<div style="margin-bottom:6px"><strong>${f.i}.</strong> ${f.q.replace(/^\d+\.\s*/,'')}<br>
          Jawabanmu: ${f.chosen === null ? '<em>tidak dijawab</em>' : f.chosen} — ${f.correct ? '<span class="correct">Benar</span>' : '<span class="wrong">Salah</span>'}<br>
          Jawaban benar: <strong>${f.original}</strong></div>`;
        list.appendChild(el);
      });
      rdiv.appendChild(list);
      window.scrollTo({top:document.body.scrollHeight, behavior:'smooth'});
    });

    document.getElementById('retry').addEventListener('click', ()=>{
      document.getElementById('result').style.display='none';
      buildQuiz();
    });

    // inisialisasi
    buildQuiz();
  </script>
</body>
</html>
